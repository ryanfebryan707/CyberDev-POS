DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
DATABASE_URL_UNPOOLED=
APP_URL=https://your-project.vercel.app
ADMIN_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Hanya bootstrap / pemulihan login pertama Admin yang belum pernah berhasil masuk.
# Hapus setelah login Admin pertama berhasil, lalu gunakan menu Ganti Password.
ADMIN_PHONE_ALIASES=
GOOGLE_CLIENT_ID=
# Opsional: hanya untuk jalur OAuth authorization-code lama. Tombol Google Identity Services tidak memerlukannya.
GOOGLE_CLIENT_SECRET=
