DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full
DATABASE_URL_UNPOOLED=
# Fallback hosting yang memakai nama secret khusus. Pada Cloudflare, binding HYPERDRIVE lebih disarankan.
CYBERDEV_DATABASE_URL=
CYBERDEV_DATABASE_URL_UNPOOLED=
APP_URL=https://cyberdev.my.id
ADMIN_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
CYBERDEV_ADMIN_BOOTSTRAP_PASSWORD=
# Hanya bootstrap / pemulihan sebelum login pertama Admin berhasil.
# Setelah login pertama, hash di database tetap berlaku; perubahan password
# Super-Admin dari dashboard sengaja diblokir pada production.
ADMIN_PHONE_ALIASES=
GOOGLE_CLIENT_ID=
# Opsional: hanya untuk jalur OAuth authorization-code lama. Tombol Google Identity Services tidak memerlukannya.
GOOGLE_CLIENT_SECRET=
